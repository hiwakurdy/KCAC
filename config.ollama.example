input:
  books_jsonl: input/books.jsonl
  images_root: ds_test/409/images

output:
  root: output

engines:
  tesseract:
    enabled: false
    lang: ckb
    psm: 6
  kraken:
    enabled: false
    model: kraken_arabic_historical_v1.mlmodel
  calamari:
    enabled: false
    model: calamari_arabic_v1.ckpt
  qwen2vl:
    enabled: true
    backend: ollama
    line_source: text_lines
    model_id: qwen25vl-sorani-ocr:latest
    ollama_host: http://localhost:11434
    num_ctx: 2048
    num_predict: 256
    temperature: 0
    max_image_side: 1280
    timeout_seconds: 180
  claude:
    enabled: false
    model: claude-sonnet-4-7-20260101
    max_tokens: 256

consensus:
  iou_threshold_for_line_alignment: 0.5
  auto_accept_min_agreeing_engines: 3
  auto_accept_max_pairwise_edits: 0
  near_agreement_max_edits: 2

normalisation:
  yeh: arabic_to_kurdish
  kaf: arabic_to_kurdish
  strip_tashkeel: true
  unicode_form: NFC

splits:
  test_book_ids: ["kcac_000099", "kcac_000152"]
  val_book_ids: ["kcac_000018"]

dashboards:
  daily_report: true
  upload_to_wandb: false
